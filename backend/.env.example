# ===================================================
# Assessyn AI - Backend Server Environment Variables
# ===================================================

# Server
PORT=
NODE_ENV=

# MongoDB Connection
MONGO_URI=

# JWT Authentication
ACCESS_TOKEN_SECRET_KEY=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET_KEY=
REFRESH_TOKEN_EXPIRY=7d

# ----------------------------------------------------------------------
# Firebase Admin SDK Configuration (Backend-Only Secret Credentials)
# Obtain from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# NEVER expose FIREBASE_PRIVATE_KEY or FIREBASE_CLIENT_EMAIL to the frontend!
# ----------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Gemini AI (Evaluation, interview question generation & Live Voice)
GEMINI_API_KEY=

# Optional AI Fallback Providers
GROQ_API_KEY=
OPENAI_API_KEY=

# Cloudinary (Resume & Avatar Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend Allowed Origin (CORS)
CLIENT_URL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# Redis / Upstash (Optional distributed cache & rate limit)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_ENABLED=
REDIS_URL=

# PayU Gateway
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_BASE_URL=
